# Public HTTPS entry point. The router forwards public :9443 to this machine.
# Ports 80/443 are not available, so the certificate is issued through a DNS
# challenge delegated (one CNAME at the main DNS host) to a Cloudflare zone we control.
# Values come from ~/.config/mrm/caddy.env.
{
	http_port 8081
	https_port 9443
	auto_https disable_redirects
}

{$APP_HOST}:9443 {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		dns_challenge_override_domain {$ACME_DELEGATED_DOMAIN}
		# The factory network intercepts port-53 DNS, so skip the local propagation check;
		# Let's Encrypt validates from outside after the fixed delay.
		propagation_delay 30s
		propagation_timeout -1
	}
	encode zstd gzip
	@retiredWebhook path /api/user-daily-attendance/test-webhook /api/user-daily-attendance/test-webhook/
	respond @retiredWebhook 410
	reverse_proxy 127.0.0.1:3001
}
