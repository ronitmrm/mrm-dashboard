[Unit]
Description=MRMPL ERP web (Next.js)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/srv/mrm-erp/apps/web
EnvironmentFile=%h/.config/mrm/production.env
EnvironmentFile=-%h/.config/mrm/release.env
Environment=PATH=%h/.nvm/versions/node/v24.22.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/pg_isready -h 127.0.0.1 -q -t 60
ExecStart=%h/srv/mrm-erp/apps/web/node_modules/.bin/next start -p 3001 -H 127.0.0.1
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=default.target
