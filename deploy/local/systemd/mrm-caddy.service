[Unit]
Description=MRMPL ERP HTTPS proxy (Caddy)
After=network-online.target

[Service]
Type=notify
EnvironmentFile=%h/.config/mrm/caddy.env
ExecStart=%h/.local/bin/caddy run --config %h/srv/mrm-erp/deploy/local/Caddyfile --adapter caddyfile
ExecReload=%h/.local/bin/caddy reload --config %h/srv/mrm-erp/deploy/local/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=default.target
