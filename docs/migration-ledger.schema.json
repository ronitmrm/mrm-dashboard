{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrmpl.local/schemas/migration-ledger.schema.json",
  "type": "object",
  "required": ["migration"],
  "properties": {
    "migration": {
      "type": "object",
      "required": ["name", "status", "testSeams", "tasks", "changeLog"],
      "properties": {
        "name": { "type": "string" },
        "status": {
          "enum": ["pending", "in_progress", "complete", "blocked"]
        },
        "testSeams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"]
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "blockedBy",
              "status",
              "delivers",
              "acceptanceCriteria"
            ],
            "properties": {
              "id": { "pattern": "^(MIG|LM)-[0-9]{2}$" },
              "status": {
                "enum": ["pending", "in_progress", "complete", "blocked"]
              }
            }
          }
        },
        "changeLog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "task", "type", "summary"]
          }
        }
      }
    }
  }
}
