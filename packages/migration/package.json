{
  "name": "@workspace/migration",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "inspect:artifacts": "tsx src/commands/inspect-artifacts.ts",
    "lint": "eslint src --max-warnings 0",
    "rehearse:foundation": "tsx src/commands/rehearse-foundation.ts",
    "stage:artifacts": "tsx src/commands/stage-artifacts.ts",
    "stage:convex": "tsx src/commands/stage-convex.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "better-sqlite3": "12.2.0",
    "fflate": "0.8.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
