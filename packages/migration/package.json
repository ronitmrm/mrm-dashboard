{
  "name": "@workspace/migration",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "database:migrate": "tsx src/commands/migrate-database.ts",
    "database:emit-sql": "tsx src/commands/emit-migration-sql.ts",
    "database:emit-fingerprint-verification": "tsx src/commands/emit-fingerprint-verification-sql.ts",
    "database:transfer-constraints": "tsx src/commands/emit-transfer-constraints-sql.ts",
    "fingerprint:database": "tsx src/commands/fingerprint-database.ts",
    "inspect:artifacts": "tsx src/commands/inspect-artifacts.ts",
    "lint": "eslint src --max-warnings 0",
    "provider:preflight": "tsx src/commands/provider-preflight.ts",
    "recruitment:import": "tsx src/commands/import-recruitment-json.ts",
    "rehearse:foundation": "tsx src/commands/rehearse-foundation.ts",
    "rehearse:convex": "tsx src/commands/rehearse-convex.ts",
    "rehearse:pricing": "tsx src/commands/rehearse-pricing.ts",
    "staging:record-envelope": "tsx src/commands/record-managed-staging-envelope.ts",
    "stage:artifacts": "tsx src/commands/stage-artifacts.ts",
    "stage:convex": "tsx src/commands/stage-convex.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "fflate": "0.8.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "8.20.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
