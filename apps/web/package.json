{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "artifact:auth:refresh": "node --conditions=react-server --import tsx scripts/refresh-artifact-oidc.ts",
    "artifact:storage:migrate": "node --conditions=react-server --import tsx scripts/migrate-artifact-storage.ts",
    "artifact:uploads:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-pending-artifact-uploads.ts",
    "dev": "next dev --webpack -p 3001",
    "drawing:baseline": "node --conditions=react-server --env-file=.env.local --import tsx scripts/migrate-legacy-drawing-baseline.ts",
    "auth:provision-admin": "tsx scripts/provision-initial-administrator.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@google-cloud/storage": "8.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/oidc": "3.8.7",
    "@workspace/db": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "1.6.23",
    "fflate": "0.8.2",
    "google-auth-library": "9.15.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.5.0",
    "server-only": "0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "pg": "8.22.0",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
