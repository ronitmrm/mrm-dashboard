# Canonical PostgreSQL runtime.
# Local compose example:
# postgres://mrmpl:mrmpl@localhost:5434/mrmpl
DATABASE_URL=

# Managed runtime switch. Keep unset for local Docker. Set to 1 only in hosted
# environments, where every responsibility uses a dedicated TLS credential.
MRM_MANAGED_RUNTIME=

# Managed PostgreSQL role URLs. Web and worker may use provider-pooled
# endpoints; migration must use a direct endpoint. Reporting and test are
# intentionally separate so their privileges cannot leak into the web runtime.
WEB_DATABASE_URL=
WEB_DATABASE_POOL_MAX=2
WORKER_DATABASE_URL=
WORKER_DATABASE_POOL_MAX=2
REFRESH_WORKER_BATCH_SIZE=10
REFRESH_WORKER_ID=
REFRESH_WORKER_MAX_RETRY_DELAY_MS=30000
REFRESH_WORKER_POLL_MS=1000
MIGRATION_DATABASE_URL=
REPORTING_DATABASE_URL=
TEST_DATABASE_URL=

# Disposable acceleration and invalidation. PostgreSQL remains authoritative.
# Local compose example: redis://localhost:6380
REDIS_URL=

# Hosted Upstash REST connection. These values are server-only and must never
# use NEXT_PUBLIC_ prefixes. Redis remains disposable acceleration state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only attachment bytes. PostgreSQL stores canonical file metadata,
# checksums, and entity links; this directory remains outside version control.
# Example: /absolute/path/to/mrm-dashboard/local-data
LOCAL_FILE_STORAGE_PATH=

# Better Auth is authoritative for the unified application's fresh sessions.
# Generate a random value of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional external HR Recruitment application. The legacy HR service is a
# separate audited boundary and is embedded only when this URL is configured.
HR_RECRUITMENT_URL=

# Optional non-interactive inputs for `pnpm auth:seed-admin`. Prefer the
# interactive password prompt or --password-stdin; never persist a real
# administrator password in this file.
ADMIN_EMAIL=
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=
