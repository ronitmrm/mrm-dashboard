{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_NAME",
    "ADMIN_PASSWORD",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "LOCAL_FILE_STORAGE_PATH",
    "NEXT_PUBLIC_APP_URL",
    "REDIS_URL",
    "REFRESH_WORKER_BATCH_SIZE",
    "REFRESH_WORKER_ID",
    "REFRESH_WORKER_POLL_MS",
    "TEST_REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
