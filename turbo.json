{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_NAME",
    "ADMIN_PASSWORD",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "LOCAL_FILE_STORAGE_PATH",
    "MIGRATION_DATABASE_URL",
    "MIGRATION_START_AFTER",
    "MIGRATION_STOP_AFTER",
    "MRM_MANAGED_RUNTIME",
    "NEXT_PUBLIC_APP_URL",
    "REPORTING_DATABASE_URL",
    "REDIS_URL",
    "REFRESH_WORKER_BATCH_SIZE",
    "REFRESH_WORKER_ID",
    "REFRESH_WORKER_MAX_RETRY_DELAY_MS",
    "REFRESH_WORKER_POLL_MS",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "WEB_DATABASE_POOL_MAX",
    "WEB_DATABASE_URL",
    "WORKER_DATABASE_POOL_MAX",
    "WORKER_DATABASE_URL",
    "TEST_REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
